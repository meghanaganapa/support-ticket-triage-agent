# Which orchestration/LLM backend to use: offline | agent-sdk | anthropic | openai
# offline   = ML + rules only, no key needed, free (default)
# agent-sdk = Claude Agent SDK: Claude plans the triage and calls the agents as tools (needs ANTHROPIC_API_KEY)
TRIAGE_LLM=offline

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- OpenAI-compatible: OpenAI, Azure OpenAI, or a free local model via Ollama ---
# Ollama example: run `ollama pull llama3.1`, then:
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.1
